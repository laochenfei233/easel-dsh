# Easel 媒体模型配置（项目根 .env）
# 脚本从当前目录向上查找 .env，所以放在 C:\Users\chenfei\Documents\GitHub\Easel\dsh\apps\cli 下即可生效。
# 复制本文件为 .env，填真实值。切勿提交/截图/写进产物。

# ═══════════════════════════════════════════════════════════
# 1) TTS 配音（voice）
#
# ⚠️ 两条链路别混：
#   A. 本项目自带客户端 out/wb/tools/minimax_tts.py —— 对齐 2025 新版接口
#      POST https://api.minimax.cn/v1/t2a_v2，只要 Bearer token，**不需要 GroupId**
#   B. skills/shared/scripts/voice_clone.py —— 照旧版 api.minimax.chat?GroupId= 写的，
#      会强制要求 MINIMAX_GROUP_ID；新账号没有这个值，别用它
# ═══════════════════════════════════════════════════════════

# ---- 方案 A：MiniMax（和 H3 同一个 key，推荐）----
VOICE_PROVIDER=minimax
MINIMAX_API_KEY=填你的MiniMax_key
# 国内站（platform.minimax.cn）用这个 base；国际站是 https://api.minimax.io
MINIMAX_BASE_URL=https://api.minimax.cn
# 文档里的最新模型；旧账号也可能只有 speech-02-hd / speech-01
MINIMAX_MODEL=speech-2.8-hd
# 音色：male-qn-qingse（青涩青年）/ male-qn-jingying（精英青年）/ female-shaonv（少女）
#       presenter_male（男主持）/ audiobook_male_1（有声书男声）
VOICE_NARRATOR_VOICE_ID=male-qn-qingse

# ---- 方案 B：阿里 CosyVoice（DashScope）----
# VOICE_PROVIDER=dashscope
# DASHSCOPE_API_KEY=填你的DashScope_key
# DASHSCOPE_TTS_MODEL=cosyvoice-v2
# VOICE_NARRATOR_VOICE_ID=longxiaochun_v2

# ---- 方案 C：任意 OpenAI 兼容 /audio/speech ----
# VOICE_PROVIDER=openai-compatible
# VOICE_API_KEY=填key
# VOICE_BASE_URL=https://api.siliconflow.cn/v1
# VOICE_MODEL=FunAudioLLM/CosyVoice2-0.5B
# 不给 voice-id 时默认用 FunAudioLLM/CosyVoice2-0.5B:alex

# ---- 方案 D：Gemini TTS ----
# VOICE_PROVIDER=gemini
# GEMINI_API_KEY=填key
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_VOICE=Kore


# ═══════════════════════════════════════════════════════════
# 2) 视频生成（video）—— H3 就是这里的 MiniMax 视频模型，自带原生音频，4–15 秒片段
# ═══════════════════════════════════════════════════════════
# VIDEO_PROVIDER=minimax
# MINIMAX_API_KEY=（与上面共用同一个 key）
# MINIMAX_VIDEO_BASE=https://api.minimaxi.com
# MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-02
# MINIMAX_VIDEO_RESOLUTION=768P


# ═══════════════════════════════════════════════════════════
# 3) 图像生成（image）—— 上一轮想做手绘插画时缺的就是这个
# ═══════════════════════════════════════════════════════════
# IMG_BASE_URL=https://api.minimaxi.com/v1
# IMG_MODEL=MiniMax-Image-01
# IMG_API_KEY=（MiniMax 同一个 key）


# ═══════════════════════════════════════════════════════════
# 4) 音乐 / BGM（music）—— 可选
# ═══════════════════════════════════════════════════════════
# MUSIC_PROVIDER=dashscope
# DASHSCOPE_API_KEY=...
